# Passwords containing @, :, /, # or % must be URL encoded.
# MySQL server address and database port belong only in DATABASE_URL.
DATABASE_URL="mysql://poetverse:CHANGE_ME@127.0.0.1:3306/poetverse"
# For trusted database TLS, append ?ssl=true.
# For local MySQL 8 RSA authentication, explicitly append ?allowPublicKeyRetrieval=true if required.
# Local NestJS API listen address and port, not the MySQL connection.
# Use HOST=0.0.0.0 to allow API access from the local network.
HOST=127.0.0.1
PORT=8080
# Optional origins for a frontend hosted separately from the API.
# CORS_ORIGIN=http://localhost:3300
