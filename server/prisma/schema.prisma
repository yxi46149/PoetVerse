generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model Author {
  id        String   @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name      String   @db.VarChar(64)
  dynasty   String   @db.VarChar(16)
  bio       String?  @db.MediumText
  source    String   @default("chinese-poetry/chinese-poetry") @db.VarChar(128)
  sourceUrl String?  @map("source_url") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  poems     Poem[]

  @@unique([name, dynasty], map: "uniq_authors_name_dynasty")
  @@index([dynasty], map: "idx_authors_dynasty")
  @@map("authors")
}

model Poem {
  id                String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  title             String    @db.VarChar(512)
  authorId          String?   @map("author_id") @db.Char(36)
  authorName        String    @map("author_name") @db.VarChar(64)
  dynasty           String    @db.VarChar(16)
  form              String    @db.VarChar(16)
  content           String    @db.MediumText
  normalizedContent String    @map("normalized_content") @db.MediumText
  dedupHash         String    @unique(map: "uniq_poems_dedup") @map("dedup_hash") @db.Char(64)
  source            String    @default("chinese-poetry/chinese-poetry") @db.VarChar(128)
  sourceUrl         String?   @map("source_url") @db.VarChar(512)
  license           String    @default("PD") @db.VarChar(32)
  edition           String    @default("") @db.VarChar(128)
  status            String    @default("published") @db.VarChar(16)
  importedAt        DateTime? @map("imported_at") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  author            Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_poems_author")
  poemTags          PoemTag[]

  @@index([dynasty], map: "idx_poems_dynasty")
  @@index([authorName], map: "idx_poems_author_name")
  @@index([form], map: "idx_poems_form")
  @@index([status], map: "idx_poems_status")
  @@index([dynasty, status], map: "idx_poems_dynasty_public")
  @@index([form, status], map: "idx_poems_form_public")
  @@index([authorName, status], map: "idx_poems_author_public")
  @@index([status, authorId, importedAt], map: "idx_poems_public_overview")
  @@index([status, createdAt(sort: Desc), id], map: "idx_poems_public_latest")
  @@map("poems")
}

model Tag {
  id        String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  name      String    @unique(map: "uniq_tags_name") @db.VarChar(32)
  source    String    @default("auto") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  poemTags  PoemTag[]

  @@map("tags")
}

model PoemTag {
  poemId    String   @map("poem_id") @db.Char(36)
  tagId     String   @map("tag_id") @db.Char(36)
  source    String   @default("auto") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  poem      Poem     @relation(fields: [poemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_poem_tags_poem")
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_poem_tags_tag")

  @@id([poemId, tagId])
  @@index([tagId], map: "idx_poem_tags_tag")
  @@map("poem_tags")
}

model ImportBatch {
  id         String    @id @default(dbgenerated("(uuid())")) @db.Char(36)
  source     String    @db.VarChar(128)
  fileName   String?   @map("file_name") @db.VarChar(256)
  total      Int       @default(0)
  succeeded  Int       @default(0)
  failed     Int       @default(0)
  startedAt  DateTime  @default(now()) @map("started_at") @db.DateTime(0)
  finishedAt DateTime? @map("finished_at") @db.DateTime(0)
  operator   String    @default("script") @db.VarChar(32)

  @@map("import_batches")
}
